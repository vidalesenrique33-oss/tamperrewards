{
  "appId": "com.tamper.rewards",
  "appName": "Tamper Rewards",
  "webDir": "www",
  "backgroundColor": "#F4F1E9",
  "android": {
    "backgroundColor": "#F4F1E9",
    "allowMixedContent": false,
    "captureInput": true
  },
  "ios": {
    "backgroundColor": "#F4F1E9",
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": false,
      "backgroundColor": "#F4F1E9",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#F4F1E9",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert",
        "banner",
        "list"
      ]
    }
  }
}
